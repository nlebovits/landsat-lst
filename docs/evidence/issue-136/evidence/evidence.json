      "launch_command": "env AWS_PROFILE=radiant-earth LST_STORAGE_BACKEND=s3 LST_SHARD_COMPOSITE_VM_TYPE=c6i.4xlarge LST_GED_GAP_MASK=false uv run python scripts/experimental/submit_u16_gate_shard.py --run-id shard-S30W065-2021-2025-20260903T112514Z-u16gate2 --index 27",
